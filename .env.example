APP_ENV=development
APP_NAME=AI Customer Operations Platform
API_PREFIX=/api/v1

# Use SQLite for local development without external services, or PostgreSQL for Docker/Production
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/customer_ops
DATABASE_URL=sqlite:///./customer_ops.db
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long-abc123
ACCESS_TOKEN_EXPIRE_MINUTES=1440

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
GEMINI_API_KEY=

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

CACHE_TTL_SECONDS=300
LOG_LEVEL=INFO

FRONTEND_ORIGIN=http://localhost:5173
